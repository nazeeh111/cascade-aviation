  "resource_assumption": "One abstract unit reduces exogenous airport departure-delay pressure by 15%; each further unit compounds. This percentage is hypothetical, not an empirical effect or a real crew/aircraft resource.",
  "edge_query": "WITH departures AS (\n      SELECT origin,dest,sched_dep_utc,sched_arr_utc FROM flights\n      WHERE origin IN ('ATL','DEN','DFW','ORD') AND sched_dep_utc IS NOT NULL\n    ), expanded AS (\n      SELECT d.*,date_trunc('hour',d.sched_dep_utc)-r.k*INTERVAL 1 HOUR AS cutoff\n      FROM departures d CROSS JOIN range(4) r(k)\n    ) SELECT e.cutoff,e.origin,e.dest,count(*) AS n,\n        count(*) FILTER(WHERE e.sched_arr_utc+INTERVAL 45 MINUTE <= e.cutoff+INTERVAL 4 HOUR) AS transmissions\n      FROM expanded e JOIN (SELECT DISTINCT cutoff FROM airport_hour_features) h USING(cutoff)\n      GROUP BY e.cutoff,e.origin,e.dest",
  "label_query": "WITH label4 AS (\n    SELECT airport,cutoff,\n      sum(scheduled_hour) OVER future AS scheduled,\n      sum(stressed_hour) OVER future AS stressed,\n      sum(unlabelled_hour) OVER future AS unknown_labels,\n      sum(delay_minutes_hour) OVER future AS target_delay_minutes,\n      max(label_available_at) OVER future AS target_available_at,\n      count(*) OVER future AS label_hours\n    FROM int_airport_hours\n    WINDOW future AS (PARTITION BY airport ORDER BY cutoff ROWS BETWEEN CURRENT ROW AND 3 FOLLOWING)\n) SELECT h.* EXCLUDE(scheduled,target_rate,target_delay_minutes,target_available_at),\n         s.scheduled,s.stressed/nullif(s.scheduled,0) AS target_rate,\n         s.target_delay_minutes,s.target_available_at\n  FROM airport_hour_features h JOIN label4 s USING(airport,cutoff)\n  WHERE s.scheduled>=3 AND s.unknown_labels=0 AND s.label_hours=4\n  ORDER BY h.cutoff,h.airport",
  "target": "Sum of positive reported departure-delay minutes for observed noncancelled departures scheduled in next 4h; cancelled flight delay is unobserved and omitted",
  "overlap": "4h scenario windows at hourly cutoffs overlap; policy averages are per interval and must never be added as daily savings.",
  "limitations": [
    "Final reported schedules proxy advance schedules; no historical schedule revisions.",
    "No passenger, crew, aircraft maintenance, gate, slot, or air-traffic constraints.",
    "Four hubs and four carriers are a selected subnetwork; external propagation is omitted.",
    "This aggregate replay validates only delay-pressure fit, not flight-level recovery feasibility.",
    "Only one hop can transmit pressure, and only scheduled arrival+45min within 4h is eligible. The turn buffer and coupling are hypothetical.",
    "The allocation policy uses a 2h forecast as a risk signal for a separate 4h scenario; it is not a 4h calibrated forecast.",
    "Resource and coupling sensitivity are hypothetical. Reported reductions are simulated and not causal savings.",
    "No future tail assignments or heldout actual outcomes enter the allocation objective.",
    "Performance on Nov\u2013Dec is reported once and does not tune calibration or resource assumptions."
  ],
  "runtime_seconds": 10.145725624985062
